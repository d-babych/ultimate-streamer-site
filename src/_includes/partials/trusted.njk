<section class="trusted{% if trusted.reveal != false %} reveal{% endif %}">
  <div class="trusted__inner">
    <h2 class="trusted__title">{{ trusted.title }}</h2>
    <p class="trusted__subtitle">{{ trusted.subtitle | safe }}</p>
    <div class="trusted__grid">
      {%- for id in trusted.items %}
      {%- set t = testimonials[id] %}
      <div class="trusted__item">
        {%- if t.logo %}
        <a href="{{ t.url }}" rel="noopener"><img src="{{ t.logo }}" alt="{{ t.author }} logo" loading="lazy" style="{% if t.logoRound %}width:72px;height:72px;border-radius:50%;{% else %}width:auto;height:72px;{% endif %}object-fit:contain;margin:0 0 16px;" /></a>
        {%- endif %}
        <p class="trusted__author">{% if t.url %}<a href="{{ t.url }}" rel="noopener">{{ t.author }}</a>{% else %}{{ t.author }}{% endif %}</p>
        <p class="trusted__quote">{{ t.quote }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
