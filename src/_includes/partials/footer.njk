<footer>
    <div class="footer-links">
      {%- for key in nav.footer %}
      {%- set ref = collections.all | pageRef(key, lang, "footerLabel") %}
      <a href="{{ ref.url }}"{% if ref.lang != lang %} lang="{{ ref.lang }}"{% endif %}>{{ ref.label }}</a>
      {%- endfor %}
    </div>
    <p>{{ t.footerTagline }}</p>
    <p>© {{ site.copyright }} <a href="{{ site.author.url }}">{{ site.author.name }}</a></p>
  </footer>
