---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in collections.all | sortSitemap %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ p.data.lastmod }}</lastmod>
    {%- set alts = collections.all | alternates(p.data.translationKey) %}
    {%- if alts.length > 1 %}
    {%- for a in alts %}
    <xhtml:link rel="alternate" hreflang="{{ a.hreflang }}" href="{{ site.url }}{{ a.url }}"/>
    {%- if a.isDefault %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ a.url }}"/>
    {%- endif %}
    {%- endfor %}
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
