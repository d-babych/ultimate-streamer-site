  <script>
  (() => {
    self.addEventListener('DOMContentLoaded', () => {
      const root = self.document.querySelector('.faq-list');
      if (!root) { return; }

      const single = root.getAttribute('data-accordion') === 'single';
      const items = self.Array.from(root.querySelectorAll('.faq-item'));

      const closeItem = (item) => {
        const btn = item.querySelector('.faq-q');
        const panel = item.querySelector('.faq-a');
        if (!btn || !panel) { return; }
        item.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        panel.style.height = '0px';
        panel.setAttribute('aria-hidden', 'true');
      };

      const openItem = (item) => {
        const btn = item.querySelector('.faq-q');
        const panel = item.querySelector('.faq-a');
        if (!btn || !panel) { return; }
        if (single) {
          items.forEach((it) => { if (it !== item) { closeItem(it); } });
        }
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        panel.style.height = panel.scrollHeight + 'px';
        panel.setAttribute('aria-hidden', 'false');
      };

      items.forEach((item) => {
        const btn = item.querySelector('.faq-q');
        const panel = item.querySelector('.faq-a');
        if (!btn || !panel) { return; }
        btn.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        panel.style.height = '0px';
        const toggle = () => {
          const isOpen = item.classList.contains('open');
          if (isOpen) { closeItem(item); } else { openItem(item); }
        };
        btn.addEventListener('click', toggle);
        btn.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            toggle();
          }
        });
      });

      const hash = self.location.hash.slice(1);
      if (hash) {
        const btn = self.document.getElementById(hash);
        if (btn && btn.classList.contains('faq-q')) { btn.click(); }
      }
    });
  })();
  </script>

