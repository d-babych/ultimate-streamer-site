{% extends "base.njk" %}

{% block head_extra %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Ultimate Streamer",
    "category": "MobileApplication",
    "brand": "Ultimate Streamer",
    "description": "App para iPhone para transmitir esportes ao vivo para o YouTube com overlays, placares e replays instantâneos.",
    "url": "https://ultimate-streamer.com/pt/",
    "image": "https://ultimate-streamer.com/assets/app-preview@3x.png",
    "offers": {
      "@type": "Offer",
      "price": "0.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": "https://apps.apple.com/app/id6745222525"
    }
  }
  </script>
{% endblock %}

{% block content %}



<main>
<header class="hero">
    <img src="/assets/app-icon-large.png" srcset="/assets/app-icon-large.png 1x, /assets/app-icon-large@2x.png 2x, /assets/app-icon-large@3x.png 3x" alt="Ultimate Streamer — ícone do app de transmissão esportiva ao vivo para iPhone" class="app-icon" width="256" height="256" loading="eager" />
    <h1 data-typing-brand data-words="Ultimate|Basquete|Futebol|Padel|Futebol americano|Tênis|Hóquei">
