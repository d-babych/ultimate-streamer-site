          <img
            src="/assets/app-preview-pip@3x.png"
            srcset="/assets/app-preview-pip.png 1x, /assets/app-preview-pip@2x.png 2x, /assets/app-preview-pip@3x.png 3x"
            alt=""
            class="feature-split__img"
            loading="lazy"
          />
        </div>

      </div>
    </div>
